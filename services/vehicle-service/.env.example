# ============================================================================
# Environment Variables - Vehicle Service Configuration
# ============================================================================

# parking-management-system/services/vehicle-service/.env.example

# Service Configuration
SERVICE_NAME=vehicle-service
SERVICE_PORT=8004
ENVIRONMENT=development
DEBUG=true

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=vehicle_db
DB_USER=vehicle_user
DB_PASSWORD=your_password_here
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# Authentication
JWT_SECRET=your_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600

# API Configuration
API_PREFIX=/api/v1
CORS_ORIGINS=["*"]
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Logging
LOG_LEVEL=INFO
LOG_FILE=/app/logs/vehicle-service.log
LOG_FORMAT=json

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Cloud Services
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=vehicle-storage

# Security
RATE_LIMIT_ENABLED=true
REQUEST_TIMEOUT=30
MAX_UPLOAD_SIZE=5242880

# Vehicle Validation
VIN_VALIDATION_ENABLED=true
LICENSE_PLATE_VALIDATION_ENABLED=true