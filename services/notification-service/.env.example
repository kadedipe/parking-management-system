# ============================================================================
# Environment Variables - Notification Service Configuration
# ============================================================================

# parking-management-system/services/notification-service/.env.example

# Service Configuration
SERVICE_NAME=notification-service
SERVICE_PORT=8005
ENVIRONMENT=development
DEBUG=true

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=notification_db
DB_USER=notification_user
DB_PASSWORD=your_password_here
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Authentication
JWT_SECRET=your_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600

# API Configuration
API_PREFIX=/api/v1
CORS_ORIGINS=["*"]
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Logging
LOG_LEVEL=INFO
LOG_FILE=/app/logs/notification-service.log
LOG_FORMAT=json

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_password
EMAIL_SECURE=false
EMAIL_FROM=noreply@parkingapp.com

# SendGrid Configuration
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@parkingapp.com

# Push Notification Configuration
EXPO_ACCESS_TOKEN=your_expo_access_token
FIREBASE_CREDENTIALS_PATH=/app/firebase-credentials.json
FCM_SERVER_KEY=your_fcm_server_key

# SMS Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_MESSAGING_SERVICE_SID=your_messaging_service_sid

# Africa's Talking Configuration
AT_USERNAME=your_at_username
AT_API_KEY=your_at_api_key
AT_FROM=your_at_from_number

# Security
RATE_LIMIT_ENABLED=true
REQUEST_TIMEOUT=30
MAX_UPLOAD_SIZE=5242880

# Monitoring
SENTRY_DSN=your_sentry_dsn
DATADOG_API_KEY=your_datadog_api_key