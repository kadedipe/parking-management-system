# ============================================================================
# Parking Management System - Environment Variables
# Copy this file to .env and update the values accordingly
# ============================================================================

# ============================================================================
# Application Configuration
# ============================================================================

# Application Environment
# Options: development, staging, production
NODE_ENV=development
APP_ENV=development
APP_NAME=Parking Management System
APP_VERSION=1.0.0
APP_DEBUG=true
APP_SECRET_KEY=your-secret-key-here-change-in-production

# Server Configuration
BACKEND_PORT=8000
FRONTEND_PORT=5173
API_PREFIX=/api/v1
HOST=0.0.0.0

# ============================================================================
# Database Configuration
# ============================================================================

# PostgreSQL - Primary Database (Parking, Vehicle, Booking data)
DATABASE_URL=postgresql://user:password@localhost:5432/parking_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=parking_db
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=40
POSTGRES_POOL_TIMEOUT=30
POSTGRES_ECHO=false

# MongoDB - EV Charging Data
MONGODB_URI=mongodb://user:password@localhost:27017/charging_db
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USER=user
MONGODB_PASSWORD=password
MONGODB_DB=charging_db
MONGODB_AUTH_SOURCE=admin

# Redis - Caching & Session Storage
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_TTL=3600
REDIS_SESSION_TTL=86400

# ============================================================================
# Message Queue Configuration (Kafka)
# ============================================================================

KAFKA_BROKERS=localhost:9092
KAFKA_HOST=localhost
KAFKA_PORT=9092
KAFKA_CLIENT_ID=parking-system
KAFKA_GROUP_ID=parking-group
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_ENABLE_AUTO_COMMIT=true
KAFKA_SESSION_TIMEOUT_MS=30000
KAFKA_HEARTBEAT_INTERVAL_MS=3000
KAFKA_MAX_POLL_RECORDS=500
KAFKA_MAX_POLL_INTERVAL_MS=300000

# Kafka Topics
KAFKA_TOPIC_PARKING_EVENTS=parking-events
KAFKA_TOPIC_CHARGING_EVENTS=charging-events
KAFKA_TOPIC_VEHICLE_EVENTS=vehicle-events
KAFKA_TOPIC_NOTIFICATION_EVENTS=notification-events
KAFKA_TOPIC_BILLING_EVENTS=billing-events

# ============================================================================
# Authentication & Security
# ============================================================================

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-minimum-32-characters-long
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-minimum-32-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=parking-system
JWT_AUDIENCE=parking-api

# API Keys
API_KEY_HEADER=X-API-Key
API_KEY_EXPIRY_DAYS=365
API_KEY_RATE_LIMIT=1000

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX_REQUESTS=5
RATE_LIMIT_AUTH_WINDOW_MS=900000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=3600

# ============================================================================
# Payment Integration
# ============================================================================

# Stripe
STRIPE_SECRET_KEY=<your_stripe_secret_key>
STRIPE_PUBLISHABLE_KEY=<your_stripe_publishable_key>
STRIPE_WEBHOOK_SECRET=<your_stripe_webhook_secret>
STRIPE_ENABLED=true
STRIPE_CURRENCY=usd
STRIPE_PAYMENT_METHODS=card,paypal

# PayPal
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_ENABLED=false
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=USD

# ============================================================================
# Email & SMS Configuration
# ============================================================================

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@parking-system.com
SMTP_FROM_NAME=Parking Management System
SMTP_TLS=true
SMTP_SSL=false

# SendGrid (Alternative)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM=noreply@parking-system.com
SENDGRID_ENABLED=false

# Twilio SMS
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_ENABLED=false

# ============================================================================
# Notification Configuration
# ============================================================================

NOTIFICATION_ENABLED=true
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_SMS_ENABLED=false
NOTIFICATION_PUSH_ENABLED=true
NOTIFICATION_RETRY_ATTEMPTS=3
NOTIFICATION_RETRY_DELAY=5000

# Push Notifications (Firebase)
FIREBASE_SERVER_KEY=your-firebase-server-key
FIREBASE_SENDER_ID=your-firebase-sender-id
FIREBASE_ENABLED=false

# ============================================================================
# External Services
# ============================================================================

# Mapbox
MAPBOX_TOKEN=your-mapbox-token
MAPBOX_STYLE=mapbox://styles/mapbox/streets-v12
MAPBOX_ENABLED=true

# Google Maps (Alternative)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GOOGLE_MAPS_ENABLED=false

# OpenWeatherMap (For weather-based pricing)
OPENWEATHER_API_KEY=your-openweather-api-key
OPENWEATHER_ENABLED=false

# ============================================================================
# Monitoring & Logging
# ============================================================================

# Sentry
SENTRY_DSN=your-sentry-dsn
SENTRY_ENV=development
SENTRY_ENABLED=false
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_REPLAYS_SAMPLE_RATE=0.1

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_PATH=logs/app.log
LOG_MAX_SIZE=10485760
LOG_MAX_FILES=5
LOG_CONSOLE_ENABLED=true
LOG_FILE_ENABLED=false

# Prometheus (Metrics)
PROMETHEUS_ENABLED=false
PROMETHEUS_PATH=/metrics
PROMETHEUS_PORT=9090

# OpenTelemetry
OTEL_ENABLED=false
OTEL_SERVICE_NAME=parking-system
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ============================================================================
# Feature Flags
# ============================================================================

# Parking Features
FEATURE_EV_CHARGING_ENABLED=true
FEATURE_ADVANCED_SEARCH_ENABLED=true
FEATURE_DYNAMIC_PRICING_ENABLED=false
FEATURE_RESERVATION_ENABLED=true
FEATURE_PREPAYMENT_ENABLED=true

# User Features
FEATURE_USER_REGISTRATION_ENABLED=true
FEATURE_SOCIAL_LOGIN_ENABLED=false
FEATURE_TWO_FACTOR_AUTH_ENABLED=false
FEATURE_USER_PROFILE_ENABLED=true

# Admin Features
FEATURE_ADMIN_DASHBOARD_ENABLED=true
FEATURE_ADMIN_REPORTS_ENABLED=true
FEATURE_ADMIN_ANALYTICS_ENABLED=true

# Mobile Features
FEATURE_PUSH_NOTIFICATIONS_ENABLED=true
FEATURE_QR_CODE_ENABLED=true
FEATURE_OFFLINE_MODE_ENABLED=false

# ============================================================================
# Performance & Scaling
# ============================================================================

# Cache Configuration
CACHE_ENABLED=true
CACHE_TYPE=redis
CACHE_DEFAULT_TTL=3600

# Connection Pooling
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_POOL_PRE_PING=true

# Worker Configuration
WORKER_CONCURRENCY=4
WORKER_MAX_TASKS_PER_CHILD=1000
WORKER_TIMEOUT=300

# ============================================================================
# Backup & Recovery
# ============================================================================

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_CRON_SCHEDULE=0 2 * * *
BACKUP_AWS_S3_BUCKET=your-backup-bucket
BACKUP_AWS_REGION=us-east-1

# Disaster Recovery
DR_ENABLED=false
DR_READ_REPLICA_URL=postgresql://user:password@replica-host:5432/parking_db
DR_FAILOVER_AUTO=false
DR_FAILOVER_TIMEOUT=300

# ============================================================================
# Security & Compliance
# ============================================================================

# Security Headers
SECURITY_HEADERS_ENABLED=true
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_CSP_ENABLED=true
SECURITY_XFRAME_OPTIONS=SAMEORIGIN

# Data Privacy
DATA_ENCRYPTION_ENABLED=true
DATA_ENCRYPTION_KEY=your-encryption-key-32-bytes
DATA_MASK_LOGS=true
DATA_RETENTION_DAYS=365

# GDPR Compliance
GDPR_COMPLIANCE_ENABLED=true
GDPR_CONSENT_REQUIRED=true
GDPR_DATA_DELETION_ENABLED=true
GDPR_DATA_EXPORT_ENABLED=true

# ============================================================================
# Testing Configuration
# ============================================================================

# Test Environment
TEST_ENABLED=true
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/parking_test_db
TEST_MONGODB_URI=mongodb://user:password@localhost:27017/charging_test_db
TEST_REDIS_URL=redis://localhost:6379/1
TEST_COVERAGE_THRESHOLD=80

# Mock Services
MOCK_STRIPE=true
MOCK_EMAIL=true
MOCK_SMS=true
MOCK_MAPBOX=true

# ============================================================================
# Third-Party Integrations
# ============================================================================

# Stripe (Full)
STRIPE_API_VERSION=2023-10-16
STRIPE_WEBHOOK_ENDPOINT_SECRET=<your_stripe_secret_key>
STRIPE_WEBHOOK_URL=https://yourdomain.com/webhooks/stripe

# PayPal (Full)
PAYPAL_API_URL=https://api.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# Twilio (Full)
TWILIO_MESSAGING_SERVICE_SID=your-messaging-service-sid
TWILIO_VERIFY_SERVICE_SID=your-verify-service-sid

# Google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Facebook
FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret
FACEBOOK_REDIRECT_URI=http://localhost:8000/auth/facebook/callback

# Apple
APPLE_CLIENT_ID=your-apple-client-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY=your-apple-private-key

# ============================================================================
# Development Specific
# ============================================================================

# Hot Reload
HOT_RELOAD_ENABLED=true
HOT_RELOAD_PORT=24678

# Debugging
DEBUG_MODE=true
DEBUG_TOOLBAR_ENABLED=true
DEBUG_SQL_QUERIES=true
DEBUG_PROFILING_ENABLED=false

# Development Data
SEED_DATABASE_ON_START=true
SEED_DATA_PATH=./seed_data.json
CREATE_TEST_USERS=true
CREATE_TEST_PARKING=true

# ============================================================================
# Production Specific
# ============================================================================

# Production URLs
PRODUCTION_API_URL=https://api.yourdomain.com
PRODUCTION_WEB_URL=https://yourdomain.com
PRODUCTION_WS_URL=wss://api.yourdomain.com/ws

# Production Security
PRODUCTION_FORCE_HTTPS=true
PRODUCTION_ENABLE_SSL=true
PRODUCTION_SSL_CERT_PATH=/etc/ssl/certs/cert.pem
PRODUCTION_SSL_KEY_PATH=/etc/ssl/private/key.pem

# ============================================================================
# Kubernetes / Cloud Specific
# ============================================================================

# Kubernetes
KUBERNETES_ENABLED=false
KUBERNETES_NAMESPACE=parking-system
KUBERNETES_CONFIG_PATH=~/.kube/config

# AWS
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=parking-system-assets
AWS_S3_PUBLIC_URL=https://s3.amazonaws.com/parking-system-assets
AWS_CLOUDFRONT_DOMAIN=https://d123.cloudfront.net

# ============================================================================
# Docker Configuration
# ============================================================================

# Docker Settings
DOCKER_ENABLED=true
DOCKER_COMPOSE_FILE=docker-compose.yml
DOCKER_NETWORK=parking-network

# ============================================================================
# End of Environment Variables
# ============================================================================