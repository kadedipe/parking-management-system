# ============================================================================
# Environment Variables Example
# ============================================================================
# 
# This file serves as a template for environment variables.
# Copy this file to .env and update the values for your environment.
# Never commit .env file to version control!
#
# ============================================================================

# ============================================================================
# Application Configuration
# ============================================================================

# Application name (used in UI and meta tags)
VITE_APP_NAME="Parking Management System"

# Application version (displayed in footer and about page)
VITE_APP_VERSION="1.0.0"

# Application description (used for SEO and meta tags)
VITE_APP_DESCRIPTION="A comprehensive parking management system for modern facilities"

# Application environment: development, staging, production
VITE_ENVIRONMENT=development

# Debug mode (enable for detailed logging in development)
VITE_DEBUG=true

# ============================================================================
# API Configuration
# ============================================================================

# Backend API base URL
# Development: http://localhost:8000
# Staging: https://api-staging.parking-system.com
# Production: https://api.parking-system.com
VITE_API_URL=http://localhost:8000

# Backend API version prefix
VITE_API_VERSION=v1

# API timeout in milliseconds (default: 30000)
VITE_API_TIMEOUT=30000

# Maximum retry attempts for API calls (default: 3)
VITE_API_MAX_RETRIES=3

# ============================================================================
# WebSocket Configuration
# ============================================================================

# WebSocket URL for real-time updates
# Development: ws://localhost:8000/ws
# Staging: wss://api-staging.parking-system.com/ws
# Production: wss://api.parking-system.com/ws
VITE_WEBSOCKET_URL=ws://localhost:8000/ws

# WebSocket reconnection attempts (default: 5)
VITE_WEBSOCKET_RECONNECT_ATTEMPTS=5

# WebSocket reconnection delay in milliseconds (default: 3000)
VITE_WEBSOCKET_RECONNECT_DELAY=3000

# ============================================================================
# Authentication Configuration
# ============================================================================

# JWT token storage key (localStorage)
VITE_TOKEN_STORAGE_KEY=auth_token

# Refresh token storage key (localStorage)
VITE_REFRESH_TOKEN_STORAGE_KEY=refresh_token

# Session timeout in minutes (default: 60)
VITE_SESSION_TIMEOUT_MINUTES=60

# Auto-logout warning time in seconds (default: 60)
VITE_SESSION_WARNING_SECONDS=60

# ============================================================================
# Feature Flags
# ============================================================================

# Enable parking reservations
VITE_FEATURE_PARKING_RESERVATIONS=true

# Enable EV charging management
VITE_FEATURE_EV_CHARGING=true

# Enable dynamic pricing
VITE_FEATURE_DYNAMIC_PRICING=false

# Enable advanced analytics
VITE_FEATURE_ADVANCED_ANALYTICS=true

# Enable notifications
VITE_FEATURE_NOTIFICATIONS=true

# Enable mobile responsiveness toggle
VITE_FEATURE_MOBILE_RESPONSIVE=true

# ============================================================================
# UI Configuration
# ============================================================================

# Default theme mode: light, dark, system
VITE_DEFAULT_THEME=system

# Primary color (hex code)
VITE_PRIMARY_COLOR=#1976d2

# Secondary color (hex code)
VITE_SECONDARY_COLOR=#dc004e

# Default language/locale
VITE_DEFAULT_LOCALE=en-US

# Date format
VITE_DATE_FORMAT=MM/dd/yyyy

# Time format
VITE_TIME_FORMAT=HH:mm

# Currency symbol
VITE_CURRENCY_SYMBOL=$

# ============================================================================
# Payment Configuration
# ============================================================================

# Stripe publishable key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx

# PayPal client ID
VITE_PAYPAL_CLIENT_ID=xxxxxxxxxxxx

# Enable test payment mode
VITE_PAYMENT_TEST_MODE=true

# ============================================================================
# Monitoring & Analytics
# ============================================================================

# Sentry DSN for error tracking
VITE_SENTRY_DSN=https://xxxxxxxx@o000000.ingest.sentry.io/0000000

# Sentry environment
VITE_SENTRY_ENVIRONMENT=development

# Google Analytics tracking ID
VITE_GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

# Enable analytics tracking
VITE_ANALYTICS_ENABLED=false

# Enable performance monitoring
VITE_PERFORMANCE_MONITORING_ENABLED=true

# ============================================================================
# Map Configuration
# ============================================================================

# Google Maps API Key
VITE_GOOGLE_MAPS_API_KEY=xxxxxxxxxxxxx

# Map center latitude
VITE_MAP_DEFAULT_LATITUDE=37.7749

# Map center longitude
VITE_MAP_DEFAULT_LONGITUDE=-122.4194

# Map default zoom level
VITE_MAP_DEFAULT_ZOOM=13

# ============================================================================
# File Upload Configuration
# ============================================================================

# Maximum file size in bytes (default: 5MB)
VITE_MAX_FILE_SIZE=5242880

# Allowed file types (comma-separated)
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp

# Maximum number of files per upload (default: 5)
VITE_MAX_FILES_PER_UPLOAD=5

# ============================================================================
# Caching Configuration
# ============================================================================

# Enable service worker caching
VITE_SERVICE_WORKER_ENABLED=true

# Cache version (bump to clear cache)
VITE_CACHE_VERSION=1.0.0

# API cache TTL in milliseconds (default: 300000 - 5 minutes)
VITE_API_CACHE_TTL=300000

# Static assets cache duration in seconds (default: 86400 - 24 hours)
VITE_STATIC_CACHE_DURATION=86400

# ============================================================================
# Security Configuration
# ============================================================================

# Content Security Policy (CSP) report URI
VITE_CSP_REPORT_URI=/csp-report

# Enable CSP in development
VITE_CSP_DEVELOPMENT_ENABLED=false

# Enable CSP in production
VITE_CSP_PRODUCTION_ENABLED=true

# ============================================================================
# Development Configuration
# ============================================================================

# Enable hot module replacement
VITE_HMR_ENABLED=true

# Enable source maps
VITE_SOURCE_MAPS_ENABLED=true

# Enable mock API (for testing without backend)
VITE_MOCK_API_ENABLED=false

# Enable logging to console
VITE_LOGGING_ENABLED=true

# Enable development tools
VITE_DEV_TOOLS_ENABLED=true

# ============================================================================
# Build Configuration
# ============================================================================

# Build output directory (relative to project root)
VITE_BUILD_OUTPUT_DIR=dist

# Enable build analysis
VITE_ANALYZE_BUNDLE=false

# Enable legacy browser support (via polyfills)
VITE_LEGACY_BROWSER_SUPPORT=false

# Enable minification
VITE_MINIFY=true

# Enable tree shaking
VITE_TREE_SHAKING=true

# ============================================================================
# Documentation
# ============================================================================

# 
# Environment Variables Usage Guide:
# 
# 1. Access in JavaScript/TypeScript:
#    ```typescript
#    const apiUrl = import.meta.env.VITE_API_URL;
#    ```
# 
# 2. Access in HTML:
#    ```html
#    <title>%VITE_APP_NAME%</title>
#    ```
# 
# 3. Default Values:
#    - All variables with VITE_ prefix are exposed to the client
#    - Variables without VITE_ prefix are only available on the server
#    - NODE_ENV is automatically set by Vite
#    - BASE_URL is automatically set by Vite
# 
# 4. Best Practices:
#    - Never store sensitive data in .env files
#    - Use .env.local for local overrides (gitignored)
#    - Use .env.production for production-specific values
#    - Use .env.staging for staging-specific values
#    - Use .env.development for development-specific values
#    - Always validate environment variables in code
# 
# 5. Loading Priority (highest to lowest):
#    - .env.[mode].local (e.g., .env.development.local)
#    - .env.[mode] (e.g., .env.development)
#    - .env.local
#    - .env
# 
# 6. Type Safety:
#    Create src/vite-env.d.ts for type checking:
#    ```typescript
#    interface ImportMetaEnv {
#      readonly VITE_API_URL: string;
#      readonly VITE_APP_NAME: string;
#      // ... add other variables
#    }
#    ```
# 
# 7. Validation:
#    Consider using a validation library to ensure all required
#    environment variables are present at startup.
# 
# ============================================================================